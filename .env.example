# Copy to .env (both for local dev and, separately, in the server's deploy
# folder — same filename, different values) and fill in. Read by Docker
# Compose for ${VAR} substitution, and by the Prisma CLI when run on the host.
# .env itself must never be committed (see .gitignore).

TZ=Europe/Stockholm

# --- Database (shared between the app and db services in both compose files) ---
DB_DATABASE=publicomtools
DB_USER=publicomtools
DB_PASSWORD=change-me

# --- Traefik routing — only used by docker-compose.yml (production) ---
REPO_TYPE=latest
DOMAIN_NAME=apps.lib.kth.se
# Must match the BASE_PATH build arg baked into the image (see Dockerfile).
# Leading slash, no trailing one.
PATHPREFIX=/publicomtools

# --- Host-side tooling only (Prisma CLI) — port 5435 is the dev db on the host ---
DATABASE_URL="postgresql://publicomtools:change-me@localhost:5435/publicomtools"
