# Local dev image — used by docker-compose-dev.yml, not by production (see
# Dockerfile). Source is bind-mounted at runtime, so edits take effect
# without a rebuild. Same Node patch as Dockerfile/.nvmrc.
FROM node:22.23.2-alpine
# pdftoppm: pdf:er i skyltarnas mediebibliotek delas upp i bilder
RUN apk add --no-cache poppler-utils
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
EXPOSE 3000
CMD ["sh", "-c", "npx prisma generate && npx prisma migrate deploy && npm run dev"]
