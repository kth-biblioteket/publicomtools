generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per public computer, created on its first heartbeat.
model Computer {
  /// The publicom config name (config/hosts/<host>.env), e.g. "gc1".
  host         String      @id
  hostname     String
  profile      String?
  computerType String?
  /// COMPUTER_NAME as the computer reports it (shown in its panel)
  computerName String?
  /// Name in the admin list only; never sent to the computer
  label        String?
  /// Set when the computer was added in the admin before it was installed (else it
  /// appeared with its first heartbeat or from the seed)
  addedBy      String?
  firstSeenAt  DateTime    @default(now())
  lastSeenAt   DateTime
  lastIp       String?
  /// The latest heartbeat payload as sent by the computer.
  status       Json
  heartbeats   Heartbeat[]

  /// Host-specific config overrides ({ KEY: "value" }), on top of base + profile.
  /// See docs/config-via-publicomtools.md in the publicom repo. Config only, never secrets.
  overrides       Json      @default("{}")
  configUpdatedAt DateTime?
  configUpdatedBy String?
  /// When the computer last fetched its config (GET /api/device/config).
  /// configUpdatedAt/effective changes after this → "väntar på omstart".
  configFetchedAt DateTime?
  /// "Hämta nya inställningar nu": the next heartbeat answers reload=true until the
  /// computer has fetched its config after this time (configFetchedAt > reloadRequestedAt).
  reloadRequestedAt DateTime?
  reloadRequestedBy String?
}

/// A config layer: the shared base (kind="base", name="") or a profile
/// (kind="profile", name="signage"/"search"/…). `values` is { KEY: "value" }.
/// The effective config for a computer is base ⊕ profile ⊕ Computer.overrides.
model ConfigLayer {
  id        String   @id @default(cuid())
  kind      String
  /// Profile id used by the computers (PUBLICOM_PROFILE); fixed once created
  name      String
  /// Display name in the admin UI, e.g. "Sökdator"
  label       String?
  description String?
  values    Json
  updatedAt DateTime @updatedAt

  @@unique([kind, name])
}

/// Catalog of known config keys — metadata for the admin UI and validation.
/// Not the values themselves (those live in ConfigLayer/Computer.overrides).
/// A cache of config/catalog.json in the publicom repo (the source of truth,
/// written next to the code that reads each key); refreshed by src/lib/catalog.ts.
model ConfigKey {
  key          String  @id
  label        String
  /// Group id from the catalog's `groups` (ConfigCatalog.groups)
  group        String
  /// int | bool | string | csv | url | enum
  type         String
  /// [{ value, label }] when type = enum
  options      Json?
  /// Unit for int keys, e.g. "sekunder", "millisekunder"
  unit         String?
  /// csv only: "," or " " (WEBSITES is space-separated)
  separator    String  @default(",")
  /// What the computer uses when the key is not set anywhere
  defaultValue String?
  help         String?
  example      String?
  /// Technical (URLs, branches, SSH …): hidden by default in the admin UI
  advanced     Boolean @default(false)
  sortOrder    Int     @default(0)
}

/// Where the ConfigKey cache came from. A single row (id = 1).
model ConfigCatalog {
  id        Int      @id @default(1)
  /// e.g. "kth-biblioteket/publicom@stable:config/catalog.json" or "file:/path"
  source    String
  /// Git blob sha (or content hash for a local file)
  version   String
  /// [{ id, label }] in display order
  groups    Json
  fetchedAt DateTime
  fetchedBy String
}

/// Audit/history: one row per saved config change, with the full layer snapshot
/// after the change (enables diff and rollback).
model ConfigChange {
  id        String   @id @default(cuid())
  /// "base" | "profile:<name>" | "host:<host>"
  target    String
  snapshot  Json
  changedBy String
  changedAt DateTime @default(now())
  note      String?
  /// What this save changed: [{ key, before, after }] (null = not set). key "__profile"
  /// is a computer's profile. Null on rows from before the settings form.
  changes   Json?

  @@index([target, changedAt])
}

/// Heartbeat history, pruned after HEARTBEAT_RETENTION_DAYS (src/lib/heartbeat.ts).
model Heartbeat {
  id         BigInt   @id @default(autoincrement())
  host       String
  computer   Computer @relation(fields: [host], references: [host], onDelete: Cascade)
  receivedAt DateTime @default(now())
  status     Json

  @@index([host, receivedAt])
}

/// One login screen on a guest computer: created when the session starts
/// (login ticket), activated when someone logs in, ended at logout.
/// Only the SHA-256 of the ticket is stored. See src/lib/guest-login.ts.
model GuestLogin {
  id           String    @id
  host         String
  resourceId   String
  computerName String?
  defaultHours Int
  loginType    String
  bookingType  String
  /// pending | working | active | ended | superseded
  status       String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  activatedAt  DateTime?
  endedAt      DateTime?
  bookingId    String?
  userLabel    String?
  startTime    Int?
  endTime      Int?

  @@index([host, status])
  @@index([createdAt])
}
