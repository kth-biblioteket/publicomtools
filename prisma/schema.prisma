generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per public computer, created on its first heartbeat.
model Computer {
  /// The publicom config name (config/hosts/<host>.env), e.g. "gc1".
  host         String      @id
  hostname     String
  profile      String?
  computerType String?
  computerName String?
  firstSeenAt  DateTime    @default(now())
  lastSeenAt   DateTime
  lastIp       String?
  /// The latest heartbeat payload as sent by the computer.
  status       Json
  heartbeats   Heartbeat[]
}

/// Heartbeat history, pruned after HEARTBEAT_RETENTION_DAYS (src/lib/heartbeat.ts).
model Heartbeat {
  id         BigInt   @id @default(autoincrement())
  host       String
  computer   Computer @relation(fields: [host], references: [host], onDelete: Cascade)
  receivedAt DateTime @default(now())
  status     Json

  @@index([host, receivedAt])
}

/// One login screen on a guest computer: created when the session starts
/// (login ticket), activated when someone logs in, ended at logout.
/// Only the SHA-256 of the ticket is stored. See src/lib/guest-login.ts.
model GuestLogin {
  id           String    @id
  host         String
  resourceId   String
  computerName String?
  defaultHours Int
  loginType    String
  bookingType  String
  /// pending | working | active | ended | superseded
  status       String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  activatedAt  DateTime?
  endedAt      DateTime?
  bookingId    String?
  userLabel    String?
  startTime    Int?
  endTime      Int?

  @@index([host, status])
  @@index([createdAt])
}
