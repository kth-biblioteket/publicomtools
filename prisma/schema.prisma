generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per public computer, created on its first heartbeat.
model Computer {
  /// The publicom config name (config/hosts/<host>.env), e.g. "gc1".
  host         String      @id
  hostname     String
  /// "linux" (publicom) or "android" (PubLiKiosk): which catalog, base layer and profiles apply
  platform     String      @default("linux")
  profile      String?
  computerType String?
  /// COMPUTER_NAME as the computer reports it (shown in its panel)
  computerName String?
  /// Name in the admin list only; never sent to the computer
  label        String?
  /// Set when the computer was added in the admin before it was installed (else it
  /// appeared with its first heartbeat or from the seed)
  addedBy      String?
  firstSeenAt  DateTime    @default(now())
  lastSeenAt   DateTime
  lastIp       String?
  /// The latest heartbeat payload as sent by the computer.
  status       Json
  heartbeats   Heartbeat[]
  visits       Visit[]
  days         DeviceDay[]

  /// Host-specific config overrides ({ KEY: "value" }), on top of base + profile.
  /// See docs/config-via-publicomtools.md in the publicom repo. Config only, never secrets.
  overrides       Json      @default("{}")
  configUpdatedAt DateTime?
  configUpdatedBy String?
  /// When the computer last fetched its config (GET /api/device/config).
  /// configUpdatedAt/effective changes after this → "väntar på omstart".
  configFetchedAt DateTime?
  /// "Hämta nya inställningar nu": the next heartbeat answers reload=true until the
  /// computer runs the current settings (or fetched its config after this time); then cleared.
  reloadRequestedAt DateTime?
  reloadRequestedBy String?
  /// "Starta om datorn": the next heartbeat answers reboot=true until the computer has
  /// booted after this time (boot time = heartbeat time - uptime); then cleared.
  rebootRequestedAt DateTime?
  rebootRequestedBy String?

  /// Android: SHA-256 of the device's own token (POST /api/device/enroll). Linux computers use
  /// the shared PUBLICOM_DEVICE_TOKEN.
  tokenHash       String?   @unique
  /// SHA-256 of a one-time enrollment code from the admin, valid until enrollExpiresAt
  enrollCodeHash  String?   @unique
  enrollExpiresAt DateTime?
  enrolledAt      DateTime?
  /// Android: code that unlocks the app's settings menu on the device without network (forgotten
  /// PIN). Given to the device at enrollment (it keeps only a hash) and shown to IT under Teknik.
  recoveryCode    String?

  /// Android: "Ta skärmdump". The next heartbeat answers screenshot=true until a newer one arrives.
  screenshotRequestedAt DateTime?
  screenshotRequestedBy String?
  screenshot            DeviceScreenshot?
  /// Android: "Lås upp menyn" (after too many wrong PINs). Sent once with the next heartbeat.
  pinUnlockRequestedAt  DateTime?
  pinUnlockRequestedBy  String?
}

/// The latest screenshot of an Android tablet's screen (its own app only), JPEG.
model DeviceScreenshot {
  host     String   @id
  computer Computer @relation(fields: [host], references: [host], onDelete: Cascade)
  image    Bytes
  takenAt  DateTime
}

/// A config layer: the shared base (kind="base", name="") or a profile
/// (kind="profile", name="signage"/"search"/…). `values` is { KEY: "value" }.
/// The effective config for a computer is base ⊕ profile ⊕ Computer.overrides.
model ConfigLayer {
  id        String   @id @default(cuid())
  kind      String
  /// "linux" | "android". The base layer of a platform is kind="base", name="" (linux) or the platform
  platform  String   @default("linux")
  /// Profile id used by the computers (PUBLICOM_PROFILE); fixed once created
  name      String
  /// Display name in the admin UI, e.g. "Sökdator"
  label       String?
  description String?
  values    Json
  updatedAt DateTime @updatedAt

  @@unique([kind, name])
}

/// Catalog of known config keys — metadata for the admin UI and validation.
/// Not the values themselves (those live in ConfigLayer/Computer.overrides).
/// A cache of config/catalog.json in the publicom repo (the source of truth,
/// written next to the code that reads each key); refreshed by src/lib/catalog.ts.
model ConfigKey {
  /// "linux" (publicom's catalog) | "android" (PubLiKiosk's catalog)
  platform     String  @default("linux")
  key          String
  label        String
  /// Group id from the catalog's `groups` (ConfigCatalog.groups)
  group        String
  /// int | bool | string | csv | url | enum
  type         String
  /// [{ value, label }] when type = enum
  options      Json?
  /// Unit for int keys, e.g. "sekunder", "millisekunder"
  unit         String?
  /// csv only: "," or " " (WEBSITES is space-separated)
  separator    String  @default(",")
  /// What the computer uses when the key is not set anywhere
  defaultValue String?
  help         String?
  example      String?
  /// Technical (URLs, branches, SSH …): hidden by default in the admin UI
  advanced     Boolean @default(false)
  /// Belongs to the single computer (name, resource id …): kept when the computer changes profile
  perComputer  Boolean @default(false)
  sortOrder    Int     @default(0)

  @@id([platform, key])
}

/// Where the ConfigKey cache came from. One row per platform.
model ConfigCatalog {
  platform  String   @id @default("linux")
  /// e.g. "kth-biblioteket/publicom@stable:config/catalog.json" or "file:/path"
  source    String
  /// Git blob sha (or content hash for a local file)
  version   String
  /// [{ id, label }] in display order
  groups    Json
  fetchedAt DateTime
  fetchedBy String
}

/// Audit/history: one row per saved config change, with the full layer snapshot
/// after the change (enables diff and rollback).
model ConfigChange {
  id        String   @id @default(cuid())
  /// "base" | "profile:<name>" | "host:<host>"
  target    String
  snapshot  Json
  changedBy String
  changedAt DateTime @default(now())
  note      String?
  /// What this save changed: [{ key, before, after }] (null = not set). key "__profile"
  /// is a computer's profile. Null on rows from before the settings form.
  changes   Json?

  @@index([target, changedAt])
}

/// Heartbeat history, pruned after HEARTBEAT_RETENTION_DAYS (src/lib/heartbeat.ts).
model Heartbeat {
  id         BigInt   @id @default(autoincrement())
  host       String
  computer   Computer @relation(fields: [host], references: [host], onDelete: Cascade)
  receivedAt DateTime @default(now())
  status     Json

  @@index([host, receivedAt])
}

/// One use of a computer or kiosk, reported by the device with a later heartbeat: from the first
/// touch/keypress after the device was reset to the last activity before it was reset again (the
/// idle tail is not included). No user, address or text: only times. See src/lib/stats.ts.
model Visit {
  id        BigInt   @id @default(autoincrement())
  host      String
  computer  Computer @relation(fields: [host], references: [host], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime
  seconds   Int
  /// idle | home | logout | timeout | config | reboot | crash | end
  reason    String?
  /// Android: pages viewed during the visit
  pages     Int?
  /// Platform and profile when the visit happened, so old statistics stay right after a change
  platform  String
  profile   String?

  @@unique([host, startedAt])
  @@index([startedAt])
}

/// How long a device was running per day (Swedish date), from its heartbeats. The denominator of
/// "beläggning": a kiosk that was switched off is not "little used".
model DeviceDay {
  host          String
  computer      Computer @relation(fields: [host], references: [host], onDelete: Cascade)
  day           DateTime @db.Date
  onlineSeconds Int      @default(0)
  platform      String
  profile       String?

  @@id([host, day])
  @@index([day])
}

/// One login screen on a guest computer: created when the session starts
/// (login ticket), activated when someone logs in, ended at logout.
/// Only the SHA-256 of the ticket is stored. See src/lib/guest-login.ts.
model GuestLogin {
  id           String    @id
  host         String
  resourceId   String
  computerName String?
  defaultHours Int
  loginType    String
  bookingType  String
  /// pending | working | active | ended | superseded
  status       String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  activatedAt  DateTime?
  endedAt      DateTime?
  bookingId    String?
  userLabel    String?
  startTime    Int?
  endTime      Int?

  @@index([host, status])
  @@index([createdAt])
}
