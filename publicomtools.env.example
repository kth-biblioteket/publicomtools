# Copy to publicomtools.env — both for local dev (next to
# docker-compose-dev.yml) and on the server (next to docker-compose.yml) —
# and fill in. Injected into the app container via env_file.
# publicomtools.env itself must never be committed (see .gitignore).

# Token the public computers send in "Authorization: Bearer <token>" to the
# device API (/api/heartbeat, /api/device/*). The same value goes into
# PUBLICOM_DEVICE_TOKEN in /usr/local/bin/secrets/.secrets on each computer.
# Generate with: openssl rand -hex 32
# Leave empty to reject all computers (503).
PUBLICOM_DEVICE_TOKEN=

# --- Guest computers' login screen (/guest) ---
# almatools' login (checks library accounts in Alma) and bookingsystem-api.
#
# IMPORTANT: when a service runs as a container on the SAME host (the shared
# apps-net network), reach it by its container name, NOT its public URL. From
# inside the container the public host resolves back to the server itself
# (hairpin NAT) and the request fails with "fetch failed" — the same reason
# KTH_AUTH_JWKS_URL below uses an internal address. Include the app's own base
# path, and note the internal port is 80 (Traefik does the TLS/routing):
#   ALMA_LOGIN_URL=http://almatools/almatools/almalogin
#   BOOKING_API_URL=http://bookingsystem-api/v1/entry   (no /bookingsystem prefix internally)
# Only use the public URLs below for a service that lives on a DIFFERENT host.
ALMA_LOGIN_URL=https://apps.lib.kth.se/almatools/almalogin
# bookingsystem-api, up to and including /entry
BOOKING_API_URL=https://api.lib.kth.se/bookingsystem/v1/entry
BOOKING_SYSTEM=guestcomputers
# Write key of bookingsystem-api (API_KEY_WRITE there), used to end bookings
# at logout. Previously BOOKING_API_KEY in .secrets on every computer.
BOOKING_API_KEY=
# "Registrera bibliotekskonto" on the login screen; leave empty to hide it
REGISTER_ACCOUNT_URL=https://apps.lib.kth.se/formtools/api/v1/kthbform?formid=libraryaccount_kiosk&lang=sv&kiosk=true
# Empty the login fields, and leave the account form, after this long without activity
GUEST_CLEAR_FIELDS_MS=30000
GUEST_EXTERNAL_TIMEOUT_MS=30000

# --- Config key catalog (Inställningskatalog) ---
# Read from publicom's config/catalog.json on the branch the fleet runs, so the
# admin UI only offers keys the computers understand. Defaults below.
#PUBLICOM_CATALOG_REPO=kth-biblioteket/publicom
#PUBLICOM_CATALOG_REF=stable
# Local dev: read a checkout instead of GitHub (path as seen by the app):
#PUBLICOM_CATALOG_FILE=/path/to/publicom/config/catalog.json

# Signs this app's own session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Comma-separated list of emails allowed to see the status page.
ADMIN_EMAILS=someone@kth.se

# --- KTH Login (librarytools-auth on the same host) ---
# Internal Docker-network address of its JWKS, not the public URL (inside
# the container the public host resolves to the server itself):
#   http://librarytools-auth:3000/mrbs/.well-known/jwks.json
# Leave unset to disable KTH login.
KTH_AUTH_JWKS_URL=

# Local dev only: skip login and act as an admin. Ignored unless
# NODE_ENV=development (the production image always runs with production).
DEV_AUTH_BYPASS=false
